<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Token stored in Keystore-backed encrypted prefs; exclude to prevent useless ciphertext transfer -->
        <exclude domain="sharedpref" path="nutrition_encrypted_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nutrition_encrypted_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
